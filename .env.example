# Local development only. Copy to .env (git-ignored) and choose your own values.
RAI_DB_PASSWORD=change-me-locally
LEDGER_DB_PASSWORD=change-me-locally
# Host-side SandboxBank CLI (load-reference, serve); use the same password as above.
SANDBOXBANK_LEDGER_DSN=postgresql://ledger:change-me-locally@127.0.0.1:55432/ledger
# Integration tests (optional locally, always set in CI); see sandboxbank/README.md.
SANDBOXBANK_TEST_DSN=
