# Local development only. Copy to .env (git-ignored) and choose your own values.
RAI_DB_PASSWORD=change-me-locally
LEDGER_DB_PASSWORD=change-me-locally
ANALYTICS_DB_PASSWORD=change-me-locally
# Seconds between etl-job cycles (P2 settlement).
ETL_INTERVAL_SECONDS=60
# Host-side RAI CLI (rai db upgrade, rai audit verify); same password as RAI_DB_PASSWORD.
RAI_DATABASE_URL=postgresql://rai:change-me-locally@127.0.0.1:55431/rai
# RAI API (rai serve). It logs in as rai_api, never as the owner: set the role's password
# once with `rai db set-api-password` (reads RAI_API_DB_PASSWORD).
RAI_API_DB_PASSWORD=change-me-locally
RAI_API_DATABASE_URL=postgresql://rai_api:change-me-locally@127.0.0.1:55431/rai
# At least 32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
RAI_JWT_SECRET=
# B-35: the evidence signing key, a secret reference (`rai admin evidence-keygen --out ...`);
# empty = evidence bundles are exported unsigned.
RAI_EVIDENCE_SIGNING_KEY=

# FR-01.3, optional: single sign-on through an OpenID Connect provider (docs/api.md).
# RAI_OIDC_ISSUER=https://login.example.org/realms/rai
# RAI_OIDC_CLIENT_ID=rai-web
# RAI_OIDC_CLIENT_SECRET=env:RAI_OIDC_SECRET   # a secret reference, never the value
# RAI_OIDC_REDIRECT_URI=https://localhost:8443/v1/auth/sso/callback
# RAI_OIDC_NAME=Keycloak
# B-36: Caddy, the only way into the stack (HTTPS only). The name clients use, and "internal"
# (Caddy's local CA) or an ACME email for a public name. Host-only by default.
RAI_SITE_ADDRESS=localhost
RAI_TLS=internal
RAI_HTTPS_BIND=127.0.0.1
RAI_HTTPS_PORT=8443
# RAI worker (rai worker). Logs in as rai_worker: `rai db set-worker-password` once.
RAI_WORKER_DB_PASSWORD=change-me-locally
RAI_WORKER_DATABASE_URL=postgresql://rai_worker:change-me-locally@127.0.0.1:55431/rai
# Folder of connector configs (*.yaml) the worker may read through; see docs/api.md.
RAI_WORKER_CONNECTORS=
RAI_WORKER_STATE=.rai/worker
# rai run (CI gate): the API's URL and a project API key (POST /v1/api-keys). Never commit a key.
RAI_API_URL=http://127.0.0.1:8000
RAI_API_KEY=
# Chaos agent (docker compose --profile chaos). Linux: the group owning /var/run/docker.sock.
DOCKER_GID=
# B-24: worker public keys the agent trusts (`rai admin chaos-keygen` prints one, comma-separate
# several); empty = every fault request refused. The one environment the agent serves.
RAI_AGENT_WORKER_KEYS=
RAI_AGENT_ENVIRONMENT=SANDBOXBANK
# Worker side: the private key (a secret reference) and the agent's URL; both or neither.
RAI_WORKER_SIGNING_KEY=
RAI_WORKER_CHAOS_AGENT_URL=
# Host-side SandboxBank CLI (load-reference, serve); use the same password as above.
SANDBOXBANK_LEDGER_DSN=postgresql://ledger:change-me-locally@127.0.0.1:55432/ledger
SANDBOXBANK_ANALYTICS_DSN=postgresql://analytics:change-me-locally@127.0.0.1:55434/analytics
# Integration tests (optional locally, always set in CI); see sandboxbank/README.md.
SANDBOXBANK_TEST_DSN=
RAI_TEST_DSN=
